// --- SECTION 1: DOCKER CONTAINER LOGS (For EB / Local Containers) ---
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets

  // --- Prevents duplicate banking, account, and card service logs ---
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(banking-service|account-service|card-service).*" 
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.write.loki_backend.receiver]
}

// --- SECTION 2: OTLP RECEIVER (For Lambda / Modern Apps) ---
otelcol.receiver.otlp "gateway" {
  http { endpoint = "0.0.0.0:4318" }
  grpc { endpoint = "0.0.0.0:4317" }

  output {
    metrics = [otelcol.exporter.prometheus.to_prom.input]
    traces  = [otelcol.exporter.otlphttp.to_zipkin.input]
    logs    = [otelcol.exporter.loki.to_loki.input]
  }
}

// --- SECTION 3: EXPORTERS (The Sinks) ---

// Metrics to Prometheus
otelcol.exporter.prometheus "to_prom" {
  add_metric_suffixes = true
  resource_to_telemetry_conversion = true
  forward_to = [prometheus.remote_write.prom_backend.receiver]
}

prometheus.remote_write "prom_backend" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Traces to Zipkin
otelcol.exporter.otlphttp "to_zipkin" {
  client {
    endpoint = "http://zipkin:9411"
  }
}

// Logs to Loki (Unified from both Docker and OTLP)
otelcol.exporter.loki "to_loki" {
  forward_to = [loki.write.loki_backend.receiver]
}

loki.write "loki_backend" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}