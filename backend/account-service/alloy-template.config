// 1. Discover containers
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. RELABEL: Map Docker metadata to Loki labels
discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets

  // Extract container name (strips the leading slash)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Extract Docker Compose service name if available
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    replacement   = "banking-app"
    target_label  = "app"
  }
}

// 3. SOURCE: Read logs using the relabeled targets
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.write.loki.receiver]
}

// 4. WRITE: Push to Loki
loki.write "loki" {
  endpoint {
    url = "{LOKI_BASE_URL}/loki/api/v1/push"
  }
}